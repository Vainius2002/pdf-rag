# Copy this file to `.env` and fill in real values. Never commit `.env`.

# OpenAI API key — used for embeddings (text-embedding-3-small) and the LLM (gpt-5-mini).
OPENAI_API_KEY=sk-your-openai-key-here

# Postgres connection string used by SQLAlchemy.
# Inside docker compose, the host is `db` (the service name); for local dev outside docker use `localhost`.
DATABASE_URL=postgresql+psycopg://postgres:postgres@db:5432/filescan

# Secret used to sign JWTs. Must be long and random.
# Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET=replace-me-with-a-long-random-string
